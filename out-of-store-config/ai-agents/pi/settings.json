{
  "theme": "tokyo-night",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "tuiMode": "fullscreen",
  "enabledModels": [
    "openai-codex/gpt-5.3-codex-spark",
    "openai-codex/gpt-5.6-sol"
  ],
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "shellCommandPrefix": "shopt -s expand_aliases",
  "hideThinkingBlock": true,
  "collapseChangelog": false,
  "compaction": {
    "enabled": false,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "excludeSkills": [],
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000
  },
  "terminal": {
    "showImages": true
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "doubleEscapeAction": "tree",
  "lastChangelogVersion": "0.84.2",
  "editorPaddingX": 1,
  "enableSkillCommands": true,
  "packages": [
    "~/code/pi-extensions/main/extensions/preset",
    "~/code/pi-extensions/main/extensions/project-resources",
    "~/code/pi-extensions/main/extensions/background-bash",
    "~/code/pi-extensions/main/extensions/parrot",
    "~/code/pi-extensions/main/extensions/pi-up-history",
    "~/code/pi-extensions/main/extensions/context-commands",
    "~/code/pi-extensions/main/extensions/footer",
    "~/code/pi-extensions/main/extensions/handoff",
    "~/code/pi-extensions/main/extensions/notify",
    "~/code/pi-extensions/main/extensions/process-info",
    "~/code/pi-extensions/main/extensions/skill-metadata-templates",
    "~/code/pi-extensions/main/extensions/thinking-toggle",
    "~/code/pi-extensions/main/extensions/trust-all-projects",
    "npm:@calesennett/pi-codex-fast",
    "npm:pi-codex-status"
  ],
  "pi-codex-fast": {
    "enabled": false,
    "mode": "off"
  }
}