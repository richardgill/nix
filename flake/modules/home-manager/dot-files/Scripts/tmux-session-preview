#!/usr/bin/env bash

type="$1"
target="$2"
path="${3:-}"

preview_tmux_session() {
  local session="$1"
  local capture
  capture=$(tmux capture-pane -ep -t "$session:" -S -${FZF_PREVIEW_LINES:-200} 2>/dev/null) || return 0
  # fzf follow scrolls to the bottom, so trim blank pane rows that hide short sessions.
  printf '%s\n' "$capture" | awk '{ lines[NR]=$0 } NF { last=NR } END { for (i=1; i<=last; i++) print lines[i] }'
}

preview_dir() {
  local path="$1"
  local expanded_path="${path/#\~/$HOME}"
  if [[ ! -d "$expanded_path" ]]; then
    echo "No directory: $path"
    return
  fi
  eza --all --git --icons --color=always "$expanded_path"
}

case "$type" in
  tmux)
    preview_tmux_session "$target"
    ;;
  dir)
    preview_dir "$target"
    ;;
  recent)
    ;;
  *)
    echo "No preview"
    ;;
esac
