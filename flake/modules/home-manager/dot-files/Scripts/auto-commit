#!/usr/bin/env bash

set -euo pipefail

trap 'echo "Error on line $LINENO" >&2; exit 1' ERR

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log() {
  printf '[%s] auto-commit: %s\n' "$(date '+%H:%M:%S')" "$*" >&2
}

elapsed() {
  local start="$1"
  local end
  end=$(date +%s)
  printf '%ss' "$((end - start))"
}

ADD_ALL=false
for arg in "$@"; do
  if [ "$arg" = "--add-all" ]; then
    ADD_ALL=true
  fi
done

if [ "$ADD_ALL" = true ] || [ -z "$(git diff --cached --name-only)" ]; then
    ADD_START=$(date +%s)
    echo "$ git add ."
    if git add .; then
        log "git add . done in $(elapsed "$ADD_START")"
    else
        status=$?
        log "git add . failed after $(elapsed "$ADD_START") (exit $status)"
        exit "$status"
    fi
else
    echo "Using existing staged changes"
fi

if [ -z "$(git status --porcelain)" ]; then
    echo "Nothing to commit, working tree clean"
    exit 0
fi

printf '\n' >&2
DIFF_LINES=$(git diff --cached | wc -l | tr -d ' ')
log "Generating commit message (diff: $DIFF_LINES lines)"

PROMPT_BASE=$(cat <<EOF
Generate a succinct commit message for these changes. Output ONLY the commit message, no explanation. Do not use prefixes like [chore], [billing], etc. Keep it simple and brief for PR review.

<example>
Made pay button green
</example>

<example>
Fixed typo in error message
</example>

<example>
Removed console.log from header component
</example>

All the information to understand what changed is right here, no tool calls, do it fast: 

$(git diff --cached --stat)
EOF
)

if [ "$DIFF_LINES" -gt 400 ]; then
    PROMPT="$PROMPT_BASE"
else
    PROMPT="$PROMPT_BASE

$(git diff --cached)"
fi

COMMIT_MSG_START=$(date +%s)
COMMIT_MSG=$("$SCRIPT_DIR/ai-prompt" "$PROMPT") || {
  status=$?
  log "Commit message generation failed after $(elapsed "$COMMIT_MSG_START") (exit $status)"
  exit "$status"
}

if [ -z "$COMMIT_MSG" ]; then
  log "Commit message generation failed: empty response"
  exit 1
fi

printf '\n' >&2
log "Commit message generated in $(elapsed "$COMMIT_MSG_START"): $COMMIT_MSG"

COMMIT_START=$(date +%s)
log "Running git commit"
if git commit -m "$COMMIT_MSG"; then
  log "git commit done in $(elapsed "$COMMIT_START")"
else
  status=$?
  log "git commit failed after $(elapsed "$COMMIT_START") (exit $status)"
  exit "$status"
fi

