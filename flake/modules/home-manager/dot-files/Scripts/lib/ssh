#!/usr/bin/env bash

is_loopback_address() {
  local address="$1"

  [[ "$address" == "localhost" || "$address" == "::1" || "$address" == "0:0:0:0:0:0:0:1" || "$address" =~ ^127\. ]]
}

is_port_number() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

is_ssh_connection_value() {
  local value="$1"
  local client_ip client_port server_ip server_port extra

  # OpenSSH documents SSH_CONNECTION as: client IP, client port, server IP, server port.
  # https://man.openbsd.org/ssh#SSH_CONNECTION
  read -r client_ip client_port server_ip server_port extra <<< "$value"

  [[ -n "$client_ip" && -n "$client_port" && -n "$server_ip" && -n "$server_port" && -z "$extra" ]] || return 1
  is_port_number "$client_port" || return 1
  is_port_number "$server_port" || return 1

  # Reverse tunnels back to the local machine also set SSH_CONNECTION, but both ends are loopback.
  if is_loopback_address "$client_ip" && is_loopback_address "$server_ip"; then
    return 1
  fi

  return 0
}

current_ssh_connection() {
  if [[ -n "${TMUX:-}" ]]; then
    local ssh_env
    ssh_env=$(tmux show-environment SSH_CONNECTION 2>/dev/null) || return 1

    # update-environment updates tmux's session env on attach; show-environment reads it.
    # Removed variables are prefixed with -VAR, so only VAR=value is a real value.
    # https://github.com/tmux/tmux/blob/master/tmux.1
    # With multiple attached clients, tmux's session env is attach/refreshed state, not a per-pane physical-client truth.
    # https://superuser.com/questions/1476226/how-to-identify-the-connected-client-pid-tty-from-inside-tmux
    [[ "$ssh_env" == SSH_CONNECTION=* ]] || return 1
    printf '%s\n' "${ssh_env#SSH_CONNECTION=}"
    return 0
  fi

  [[ -n "${SSH_CONNECTION:-}" ]] || return 1
  printf '%s\n' "$SSH_CONNECTION"
}

is_ssh_session() {
  local ssh_connection
  ssh_connection=$(current_ssh_connection) || return 1

  is_ssh_connection_value "$ssh_connection"
}
