#!/usr/bin/env bash
set -euo pipefail

desktop_source=$(realpath -e "$HOME/code/overmux/active-desktop")
export OVERMUX_DESKTOP_SOURCE="$desktop_source"
export OVERMUX_ELECTRON_GPU_DIAGNOSTICS=1
export OVERMUX_SERVER_URL="http://localhost:4242"

exec nix run --impure "path:$OVERMUX_DESKTOP_SOURCE#overmux-desktop" -- "$@"
