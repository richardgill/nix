#!/usr/bin/env bash

if [[ "${PI_DELEGATE:-}" != 1 && -n "$TMUX" && -n "$TMUX_PANE" ]]; then
  window_id=$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}')
  [[ -n "$window_id" ]] && tmux rename-window -t "$window_id" "pi"
fi

export PI_EXTENSION_CONFIG_DIR="${PI_EXTENSION_CONFIG_DIR:-$HOME/.pi/agent/extension-config}"

pi_bin="$(mise which pi)"
exec "$pi_bin" "$@"
