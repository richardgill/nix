#!/usr/bin/env bash
# ai-prompt: Run a prompt through an LLM with retries and timeout
# Usage: ai-prompt "your prompt here"
#    or: echo "your prompt" | ai-prompt

set -euo pipefail

TIMEOUT_SECS="${AI_PROMPT_TIMEOUT:-30}"
MAX_RETRIES="${AI_PROMPT_RETRIES:-3}"
MODEL="${AI_PROMPT_MODEL:-gpt-5.6-luna}"
REASONING_EFFORT="${AI_PROMPT_REASONING_EFFORT:-low}"
SERVICE_TIER="${AI_PROMPT_SERVICE_TIER:-fast}"

# Read prompt from argument or stdin
if [[ $# -gt 0 && "$1" != "-" ]]; then
  PROMPT="$1"
else
  PROMPT=$(cat)
fi

[[ -z "$PROMPT" ]] && { echo "Error: No prompt provided" >&2; exit 1; }

log() {
  printf '[%s] ai-prompt: %s\n' "$(date '+%H:%M:%S')" "$*" >&2
}

elapsed() {
  local start="$1"
  local end
  end=$(date +%s)
  printf '%ss' "$((end - start))"
}

run_prompt() {
  local attempt="$1"
  local stdout_file stderr_file exit_code start
  stdout_file=$(mktemp)
  stderr_file=$(mktemp)
  start=$(date +%s)

  log "attempt $attempt/$MAX_RETRIES started (model: $MODEL, effort: $REASONING_EFFORT, service tier: $SERVICE_TIER, timeout: ${TIMEOUT_SECS}s)"

  if timeout "$TIMEOUT_SECS" codex exec -m "$MODEL" -c model_reasoning_effort="$REASONING_EFFORT" -c service_tier="$SERVICE_TIER" "$PROMPT" >"$stdout_file" 2>"$stderr_file"; then
    exit_code=0
  else
    exit_code=$?
  fi

  if [ "$exit_code" -eq 0 ]; then
    log "attempt $attempt/$MAX_RETRIES succeeded in $(elapsed "$start")"
    cat "$stdout_file"
    rm -f "$stdout_file" "$stderr_file"
    return 0
  fi

  if [ "$exit_code" -eq 124 ]; then
    log "attempt $attempt/$MAX_RETRIES timed out after $(elapsed "$start")"
  else
    log "attempt $attempt/$MAX_RETRIES failed after $(elapsed "$start") (exit $exit_code)"
  fi

  if [ -s "$stderr_file" ]; then
    cat "$stderr_file" >&2
  elif [ -s "$stdout_file" ]; then
    cat "$stdout_file" >&2
  fi

  rm -f "$stdout_file" "$stderr_file"
  return 1
}

for attempt in $(seq 1 "$MAX_RETRIES"); do
  if run_prompt "$attempt"; then
    exit 0
  fi

  if [ "$attempt" -lt "$MAX_RETRIES" ]; then
    log "retrying in 1s"
    sleep 1
  fi
done

log "failed after $MAX_RETRIES attempts"
echo "Error: Failed after $MAX_RETRIES attempts" >&2
exit 1
