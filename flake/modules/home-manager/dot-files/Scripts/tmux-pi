#!/usr/bin/env bash
# @describe Launch a supervised Pi agent in tmux
# @option --prompt-file File containing the delegated Pi prompt
# @option --task-slug Short lowercase task name used for the window name
# @flag --skill Mark the child as a skill invocation
# @flag --block-nested Prevent the launched child from delegating
# @flag --no-callback Launch without notifying the parent when the child settles
# @option --pi-session Pi session file to fork
# @option --model Pi model
# @option --thinking Pi thinking level
# @option --target Existing repo or worktree path (defaults to the current tmux session and directory)
# @option --worktree Create a worktree with this branch name
# @option --source-ref Explicit source ref for the new worktree

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

validate_task_name() {
  [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,11}[a-z0-9])?$ ]] || fail "--task-slug must be lowercase, contain only letters, numbers, or hyphens, and be at most 13 characters"
}

resolve_session_id() {
  local session_file="$1"
  local session_id

  if [[ -z "$session_file" ]]; then
    session_id=$(uuidgen) || fail "could not generate a Pi session ID"
    printf '%s' "$session_id" | tr '[:upper:]' '[:lower:]'
    return
  fi

  [[ -f "$session_file" ]] || fail "--pi-session does not exist or is not a file: $session_file"
  session_id=$(head -n 1 "$session_file" | jq -er 'select(.type == "session") | .id') || fail "--pi-session has no valid session header: $session_file"
  printf '%s' "$session_id"
}

prepare_prompt() {
  local channel="$1"
  local source_file="$2"
  local block_nested="$3"
  local prepared_file="/tmp/pi-prompt-${channel}.md"
  local delegation_instruction='You may delegate distinct, self-contained subtasks when useful, but do not merely redelegate this task.'

  [[ -f "$source_file" ]] || fail "--prompt-file does not exist or is not a file: $source_file"
  [[ -z "$block_nested" ]] || delegation_instruction='Do not invoke tmux-pi or delegate.'
  {
    printf '%s %s\n\n' 'You are the worker already launched for this task. Treat requests to perform this "in a thread" as already satisfied. Complete only the substantive task; the parent owns follow-on work.' "$delegation_instruction"
    cat "$source_file"
  } > "$prepared_file"
  printf '%s' "$prepared_file"
}

build_pi_command() {
  local prompt_file="$1"
  local pi_session="$2"
  local session_id="$3"
  local parent_session_id="$4"
  local task_slug="$5"
  local model="$6"
  local thinking="$7"
  local skill="$8"
  local block_nested="$9"
  local pi_binary
  local args

  pi_binary=$(command -v pi) || fail "pi is not on PATH"
  args=(env -u PI_SKILL_CHILD -u PI_BLOCK_NESTED -u PI_PARENT_SESSION_ID PI_CHILD=1 PI_TASK_SLUG="$task_slug")
  [[ -n "$parent_session_id" ]] && args+=(PI_PARENT_SESSION_ID="$parent_session_id")
  [[ -n "$skill" ]] && args+=(PI_SKILL_CHILD=1)
  [[ -n "$block_nested" ]] && args+=(PI_BLOCK_NESTED=1)
  args+=("$pi_binary")
  if [[ -n "$pi_session" ]]; then
    args+=(--session "$pi_session")
  else
    args+=(--session-id "$session_id")
  fi
  [[ -n "$model" ]] && args+=(--model "$model")
  [[ -n "$thinking" ]] && args+=(--thinking "$thinking")
  args+=("@$prompt_file")
  printf '%q ' "${args[@]}"
}

resolve_target() {
  local worktree="$1"
  local source_ref="$2"
  local target="$3"
  local main_worktree
  local session
  local args=(--no-switch --no-agent --pull)

  if [[ -z "$worktree" && -z "$target" ]]; then
    TARGET_CWD=$(realpath "$PWD")
    TARGET_SESSION=$(tmux display-message -p '#{session_name}') || fail "--target is required outside tmux"
    return
  fi

  if [[ -n "$worktree" ]]; then
    if [[ "$(basename "$PWD")" == "main" && -d "$PWD/.git" ]]; then
      main_worktree=$(realpath "$PWD")
    else
      [[ -d "$PWD/../main/.git" ]] || fail "run from the main worktree or one of its sibling worktrees"
      main_worktree=$(realpath "$PWD/../main")
    fi

    target="$main_worktree/../${worktree//\//-}"
    if [[ -n "$source_ref" ]]; then
      (cd "$main_worktree" && "$HOME/Scripts/worktree-branch" "${args[@]}" "$source_ref" "$worktree") || exit 1
    else
      (cd "$main_worktree" && "$HOME/Scripts/worktree-branch" "${args[@]}" "$worktree") || exit 1
    fi
  fi

  TARGET_CWD=$(realpath "$target") || fail "target does not exist: $target"
  session=$(tmux list-panes -a -F $'#{session_name}\t#{pane_current_path}' |
    awk -F '\t' -v path="$TARGET_CWD" '$2 == path { print $1; exit }')
  [[ -n "$session" ]] || fail "could not find the tmux session for $TARGET_CWD"
  TARGET_SESSION="$session"
}

launch_pi_window() {
  local task="$1"
  local session="$2"
  local cwd="$3"
  local command="$4"
  local current_session=""

  WINDOW_ID=$(tmux new-window -d -P -F '#{window_id}' \
    -t "${session}:" \
    -c "$cwd" \
    -n "$task" \
    "$command") || return 1
  tmux set-option -p -t "$WINDOW_ID" allow-rename off >/dev/null || return 1
  tmux set-window-option -t "$WINDOW_ID" automatic-rename off >/dev/null || return 1
  tmux rename-window -t "$WINDOW_ID" "$task" || return 1

  if [[ -n "${TMUX_PANE:-}" ]]; then
    current_session=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}') || return 1
  fi

  # Select the child in another session without moving the client from its current session.
  if [[ "$session" != "$current_session" ]]; then
    tmux select-window -t "$WINDOW_ID" || return 1
  fi
}

run() {
  eval "$(argc --argc-eval "$0" "$@")"

  [[ -n "${argc_prompt_file:-}" ]] || fail "--prompt-file is required"
  [[ -n "${argc_task_slug:-}" ]] || fail "--task-slug is required"
  [[ "${PI_BLOCK_NESTED:-}" != 1 ]] || fail "nested delegation is blocked; complete the task in this worker"
  [[ -n "${argc_no_callback:-}" || -n "${PI_SESSION_ID:-}" ]] || fail "tmux-pi must be launched from a persisted parent Pi session unless --no-callback is used"
  [[ -z "${argc_source_ref:-}" || -n "${argc_worktree:-}" ]] || fail "--source-ref requires --worktree"
  [[ -z "${argc_worktree:-}" || -z "${argc_target:-}" ]] || fail "--worktree cannot be combined with --target"

  local task_name
  local session_id
  local prepared_prompt
  local pi_command
  local parent_session_id="${PI_SESSION_ID:-}"
  local callback_status="enabled"

  if [[ -n "${argc_no_callback:-}" ]]; then
    parent_session_id=""
    callback_status="disabled"
  fi

  task_name="$argc_task_slug"
  validate_task_name "$task_name"
  session_id=$(resolve_session_id "${argc_pi_session:-}")
  prepared_prompt=$(prepare_prompt "$session_id" "$argc_prompt_file" "${argc_block_nested:-}")
  pi_command=$(build_pi_command "$prepared_prompt" "${argc_pi_session:-}" "$session_id" "$parent_session_id" "$task_name" "${argc_model:-}" "${argc_thinking:-}" "${argc_skill:-}" "${argc_block_nested:-}")

  resolve_target "${argc_worktree:-}" "${argc_source_ref:-}" "${argc_target:-}"
  launch_pi_window "$task_name" "$TARGET_SESSION" "$TARGET_CWD" "$pi_command" || fail "failed to launch child Pi"
  printf '✓ %s launched\n  Pi session:  %s\n  Tmux window: %s\n  Callback:    %s\n' "$task_name" "$session_id" "$WINDOW_ID" "$callback_status"

  local deep_link_prefix
  local tmux_path
  if deep_link_prefix=$(overmux instance --json 2>/dev/null | jq -er '.deepLinkPrefix // empty') &&
    tmux_path=$(tmux display-message -p -t "$WINDOW_ID" '#{session_id}/#{window_id}/#{pane_id}' 2>/dev/null); then
    tmux_path=${tmux_path//[\$@%]/}
    printf '\n%s/tmux/%s\n' "$deep_link_prefix" "$tmux_path"
  fi
}

run "$@"
