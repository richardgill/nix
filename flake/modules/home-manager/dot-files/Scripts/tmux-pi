#!/usr/bin/env bash
# @describe Launch a supervised Pi agent in tmux
# @option --prompt-file File containing the delegated Pi prompt
# @option --task-slug Short lowercase task name used for the window name
# @flag --skill Mark the child as a delegated skill invocation
# @option --pi-session Pi session file to fork
# @option --model Pi model
# @option --thinking Pi thinking level
# @option --target Existing repo or worktree path (defaults to the current tmux session and directory)
# @option --worktree Create a worktree with this branch name
# @option --source-ref Explicit source ref for the new worktree

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

validate_task_name() {
  [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,11}[a-z0-9])?$ ]] || fail "--task-slug must be lowercase, contain only letters, numbers, or hyphens, and be at most 13 characters"
}

resolve_session_id() {
  local session_file="$1"
  local session_id

  if [[ -z "$session_file" ]]; then
    session_id=$(uuidgen) || fail "could not generate a Pi session ID"
    printf '%s' "$session_id" | tr '[:upper:]' '[:lower:]'
    return
  fi

  [[ -f "$session_file" ]] || fail "--pi-session does not exist or is not a file: $session_file"
  session_id=$(head -n 1 "$session_file" | jq -er 'select(.type == "session") | .id') || fail "--pi-session has no valid session header: $session_file"
  printf '%s' "$session_id"
}

prepare_prompt() {
  local channel="$1"
  local source_file="$2"
  local prepared_file="/tmp/pi-prompt-${channel}.md"

  [[ -f "$source_file" ]] || fail "--prompt-file does not exist or is not a file: $source_file"
  {
    printf '%s\n\n' 'You are running as a delegate. Do not immediately redelegate this task. First inspect the relevant code and establish the implementation shape. Delegate only if a distinct, self-contained subtask remains.'
    cat "$source_file"
  } > "$prepared_file"
  printf '%s' "$prepared_file"
}

build_pi_command() {
  local prompt_file="$1"
  local pi_session="$2"
  local session_id="$3"
  local parent_session_id="$4"
  local task_slug="$5"
  local model="$6"
  local thinking="$7"
  local skill="$8"
  local pi_binary
  local args

  pi_binary=$(command -v pi) || fail "pi is not on PATH"
  args=(env -u PI_SKILL_DELEGATE PI_DELEGATE=1 PI_DELEGATE_PARENT_SESSION_ID="$parent_session_id" PI_DELEGATE_TASK_SLUG="$task_slug")
  [[ -n "$skill" ]] && args+=(PI_SKILL_DELEGATE=1)
  args+=("$pi_binary")
  if [[ -n "$pi_session" ]]; then
    args+=(--session "$pi_session")
  else
    args+=(--session-id "$session_id")
  fi
  [[ -n "$model" ]] && args+=(--model "$model")
  [[ -n "$thinking" ]] && args+=(--thinking "$thinking")
  args+=("@$prompt_file")
  printf '%q ' "${args[@]}"
}

resolve_target() {
  local worktree="$1"
  local source_ref="$2"
  local target="$3"
  local main_worktree
  local session
  local args=(--no-switch --no-agent --pull)

  if [[ -z "$worktree" && -z "$target" ]]; then
    TARGET_CWD=$(realpath "$PWD")
    TARGET_SESSION=$(tmux display-message -p '#{session_name}') || fail "--target is required outside tmux"
    return
  fi

  if [[ -n "$worktree" ]]; then
    if [[ "$(basename "$PWD")" == "main" && -d "$PWD/.git" ]]; then
      main_worktree=$(realpath "$PWD")
    else
      [[ -d "$PWD/../main/.git" ]] || fail "run from the main worktree or one of its sibling worktrees"
      main_worktree=$(realpath "$PWD/../main")
    fi

    target="$main_worktree/../${worktree//\//-}"
    if [[ -n "$source_ref" ]]; then
      (cd "$main_worktree" && "$HOME/Scripts/worktree-branch" "${args[@]}" "$source_ref" "$worktree") || exit 1
    else
      (cd "$main_worktree" && "$HOME/Scripts/worktree-branch" "${args[@]}" "$worktree") || exit 1
    fi
  fi

  TARGET_CWD=$(realpath "$target") || fail "target does not exist: $target"
  session=$(tmux list-panes -a -F $'#{session_name}\t#{pane_current_path}' |
    awk -F '\t' -v path="$TARGET_CWD" '$2 == path { print $1; exit }')
  [[ -n "$session" ]] || fail "could not find the tmux session for $TARGET_CWD"
  TARGET_SESSION="$session"
}

launch_pi_window() {
  local task="$1"
  local session="$2"
  local cwd="$3"
  local command="$4"

  WINDOW_ID=$(tmux new-window -d -P -F '#{window_id}' \
    -t "${session}:" \
    -c "$cwd" \
    -n "$task" \
    "$command") || return 1
  tmux set-option -p -t "$WINDOW_ID" allow-rename off >/dev/null || return 1
  tmux set-window-option -t "$WINDOW_ID" automatic-rename off >/dev/null || return 1
  tmux rename-window -t "$WINDOW_ID" "$task" || return 1
}

run() {
  eval "$(argc --argc-eval "$0" "$@")"

  [[ -n "${argc_prompt_file:-}" ]] || fail "--prompt-file is required"
  [[ -n "${argc_task_slug:-}" ]] || fail "--task-slug is required"
  [[ -n "${PI_SESSION_ID:-}" ]] || fail "tmux-pi must be launched from a persisted parent Pi session"
  [[ -z "${argc_source_ref:-}" || -n "${argc_worktree:-}" ]] || fail "--source-ref requires --worktree"
  [[ -z "${argc_worktree:-}" || -z "${argc_target:-}" ]] || fail "--worktree cannot be combined with --target"

  local task_name
  local session_id
  local prepared_prompt
  local pi_command

  task_name="$argc_task_slug"
  validate_task_name "$task_name"
  session_id=$(resolve_session_id "${argc_pi_session:-}")
  prepared_prompt=$(prepare_prompt "$session_id" "$argc_prompt_file")
  pi_command=$(build_pi_command "$prepared_prompt" "${argc_pi_session:-}" "$session_id" "$PI_SESSION_ID" "$task_name" "${argc_model:-}" "${argc_thinking:-}" "${argc_skill:-}")

  resolve_target "${argc_worktree:-}" "${argc_source_ref:-}" "${argc_target:-}"
  launch_pi_window "$task_name" "$TARGET_SESSION" "$TARGET_CWD" "$pi_command" || fail "failed to launch delegated Pi"
  printf '✓ %s launched\n  Pi session:  %s\n  Tmux window: %s\n' "$task_name" "$session_id" "$WINDOW_ID"
}

run "$@"
