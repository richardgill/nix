#!/usr/bin/env bash

# Exit on any error
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/git"

# Check for existing PR
echo "Checking for existing pull request..."
CURRENT_BRANCH=$(git branch --show-current)
BASE_REMOTE=$(get_default_remote main)
BASE_REPOSITORY=$(git remote get-url "$BASE_REMOTE")
PR_URL=$(gh pr list --repo "$BASE_REPOSITORY" --head "$CURRENT_BRANCH" --json url --jq '.[0].url // empty')

if [ -z "$PR_URL" ]; then
    echo "No existing PR found. Creating draft pull request..."
    git push --set-upstream origin "$CURRENT_BRANCH"

    # Create draft PR with auto-filled title and empty body
    PR_URL=$(gh pr create --repo "$BASE_REPOSITORY" --draft --fill-first --body "")
    echo "Draft pull request created: $PR_URL"
else
    echo "Pull request already exists for branch '$CURRENT_BRANCH'"
fi

# Open in browser
gh pr view "$PR_URL" --web
