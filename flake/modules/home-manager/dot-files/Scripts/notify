#!/usr/bin/env bash
set -euo pipefail

export NTFY_AGENT_TOPIC_FILE="${NTFY_AGENT_TOPIC_FILE:-/run/secrets/ntfy-agent-topic}"
export NTFY_GITHUB_TOPIC_FILE="${NTFY_GITHUB_TOPIC_FILE:-/run/secrets/ntfy-github-topic}"

repo_dir="$HOME/code/nix-private/out-of-store-config/services/ai-cron"
cd "$repo_dir"
exec pnpm exec tsx src/cli.ts "$@"
