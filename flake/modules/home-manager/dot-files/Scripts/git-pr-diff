#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

current_branch=$(git symbolic-ref --short HEAD)
base_ref=$("$SCRIPT_DIR/git-diff-base-ref" base)
remote="${base_ref%%/*}"

echo "📡 Fetching $remote..." >&2
git fetch "$remote"

echo -e "\n── 📋 PR Diff (commits not in $base_ref) ──" >&2
git diff "$base_ref...$current_branch"

echo -e "\n── 📝 Working Directory (staged + unstaged + untracked) ──" >&2
git-local-diff
