#!/usr/bin/env bash

source "$(dirname "$0")/lib/tmux-state"

session="${1:-}"
[[ -n "$session" ]] || exit 0

path="${2:-}"
if [[ -z "$path" ]]; then
  path=$(tmux display-message -p -t "$session:" '#{session_path}' 2>/dev/null || true)
fi

file=$(tmux_recency_file)
mkdir -p "$(dirname "$file")"

tmp=$(mktemp)
printf '%s\t%s\t%s\n' "$(date +%s)" "$session" "$path" > "$tmp"
if [[ -f "$file" ]]; then
  awk -F '\t' -v session="$session" 'NF >= 2 && $2 != session' "$file" >> "$tmp"
fi
mv "$tmp" "$file"
