# BASH_ENV is sourced by non-interactive bash scripts
# https://www.gnu.org/software/bash/manual/html_node/Bash-Startup-Files.html
export BASH_ENV="$HOME/.bash_profile"

if [ -r "/home/rich/.config/sops-nix/secrets/kagi-api-key" ]; then
  export KAGI_API_KEY="$(cat "/home/rich/.config/sops-nix/secrets/kagi-api-key")"
fi
if [ -r "/home/rich/.config/sops-nix/secrets/kagi-session-token" ]; then
  export KAGI_SESSION_TOKEN="$(cat "/home/rich/.config/sops-nix/secrets/kagi-session-token")"
fi
if [ -r "/home/rich/.config/sops-nix/secrets/exa-api-key" ]; then
  export EXA_API_KEY="$(cat "/home/rich/.config/sops-nix/secrets/exa-api-key")"
fi

# Dynamically loads .env.shell and .env.*.shell files by traversing up parent directories
if [ -f "$HOME/.config/shell/env-shell-loader.sh" ]; then
  source "$HOME/.config/shell/env-shell-loader.sh"
fi
