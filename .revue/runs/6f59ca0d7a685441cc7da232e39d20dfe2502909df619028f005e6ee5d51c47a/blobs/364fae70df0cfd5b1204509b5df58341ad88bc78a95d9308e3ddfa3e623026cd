{
  "theme": "tokyo-night",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-5.3-codex-spark",
    "openai-codex/gpt-5.6-sol"
  ],
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "shellInitCommand": "shopt -s expand_aliases; eval ",
  "hideThinkingBlock": true,
  "collapseChangelog": false,
  "compaction": {
    "enabled": false,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "excludeSkills": [],
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000
  },
  "terminal": {
    "showImages": true
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "doubleEscapeAction": "tree",
  "lastChangelogVersion": "0.83.0",
  "editorPaddingX": 1,
  "enableSkillCommands": true,
  "packages": [
    "~/code/pi-extensions/main/extensions/preset",
    "~/code/pi-extensions/main/extensions/sub-pi",
    "~/code/pi-extensions/main/extensions/sub-pi-skill",
    "~/code/pi-extensions/main/extensions/file-collector",
    "~/code/pi-extensions/main/extensions/project-resources",
    "~/code/pi-extensions/main/extensions/tmux-bash",
    "~/code/pi-extensions/main/extensions/parrot",
    "~/code/pi-extensions/main/extensions/pi-up-history",
    "~/code/pi-extensions/main/extensions/context-commands",
    "npm:@calesennett/pi-codex-fast",
    "npm:pi-codex-status"
  ],
  "pi-codex-fast": {
    "enabled": true
  }
}
